# Copy to .env.local and fill in from `supabase status` (local dev) or your Supabase project settings (production).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS -- never expose to the client, never import outside lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Domain members must sign up with, checked in the signup Server Action and again in the DB trigger.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=bergen.org

# Used to build email confirmation / password reset redirect links. Set to the deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
